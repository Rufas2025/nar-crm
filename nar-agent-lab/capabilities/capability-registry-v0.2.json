    {
      "TOOL_NAME": "eduinfo_list_root",
      "DOMAIN": "eduinfo",
      "OWNER": "engenharia-nar",
      "PURPOSE": "Listar itens autorizados da raiz Eduinfo.",
      "INPUT_SCHEMA": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": []
      },
      "OUTPUT_SCHEMA": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "mimeType",
                "isFolder",
                "size"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "isFolder": {
                  "type": "boolean"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "READ_ONLY": true,
      "ALLOWED_AGENTS": [
        "marketing-nar",
        "produto-nar",
        "engenharia-nar"
      ],
      "DENIED_AGENTS": [
        "rufas-router",
        "atendimento-nar",
        "crm-nar"
      ],
      "SIDE_EFFECTS": [],
      "APPROVAL_REQUIRED": false,
      "FAILURE_MODES": [
        "ACCESS_DENIED para atendimento-nar, crm-nar e rufas-router",
        "INVALID_INPUT se o chamador tentar passar raiz ou credencial",
        "LIMIT_EXCEEDED acima de 100"
      ],
      "MOCK_BEHAVIOR": "Retorna as 3 pastas autorizadas de mock-data/eduinfo.json. A pasta Financeiro_Restrito nunca é listada.",
      "FUTURE_REAL_BACKEND": "Google Drive API (files.list) restrita por allowlist de Folder_ID no servidor, com service account de leitura.",
      "OBSERVES": {
        "entity": "drive_asset",
        "temporality": "static_document",
        "facts": [
          "itens autorizados na raiz do acervo: id, nome, mimeType, se e pasta, tamanho"
        ],
        "not_observed": [
          "conteudo interno do arquivo",
          "classificacao semantica do documento (que assunto o arquivo trata)",
          "telemetria, logs, latencia ou uptime de sistema"
        ],
        "observable_by_use": [
          "disponibilidade e autorizacao do acervo (ACCESS_DENIED, ASSET_OUT_OF_SCOPE)",
          "existencia do item (FOLDER_NOT_FOUND, FILE_NOT_FOUND)"
        ]
      }
    },
