  "observational_model": {
    "principle": "Capability gap e uma afirmacao sobre AUSENCIA. Ausencia nao se le numa tool isolada, so no conjunto fechado — por isso NOT_OBSERVED_BY_ANY_TOOL e normativo, nao ilustrativo.",
    "temporality_values": [
      "current_state",
      "event_history",
      "static_document",
      "current_state + event_history"
    ],
    "observable_by_use": "Comportamento que so se conhece exercitando a tool (erro contratual, escopo, existencia). Declarado apenas onde os FAILURE_MODES do contrato o sustentam. Latencia e desempenho NAO sao observaveis por nenhuma tool: nenhum schema expoe tempo de resposta."
  },
  "NOT_OBSERVED_BY_ANY_TOOL": [
    "transicao de stage ao longo do tempo (quantos contatos mudaram de fase num periodo) — nenhuma tool expoe serie historica de stage",
