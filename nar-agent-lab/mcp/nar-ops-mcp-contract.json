{
  "mcp_name": "nar-ops-mcp",
  "contract_version": "0.1.0",
  "status": "LAB",
  "environment": "mock",
  "frozen": true,
  "frozen_at": "2026-09-01",
  "description": "Contrato de capabilities de negócio do ecossistema NAR. Laboratório read-only: nenhum backend real, nenhum endpoint publicado, nenhuma credencial.",
  "non_production_notice": [
    "Este contrato NÃO descreve um servidor de produção.",
    "Nenhuma tool aqui conecta CRM real, Google Drive real ou n8n real.",
    "Nenhuma credencial ou secret é requerida, aceita ou armazenada.",
    "Nenhuma tool produz side effect."
  ],
  "policy": {
    "read_only_enforced": true,
    "fail_closed": true,
    "deny_by_default": true,
    "no_credentials": true,
    "no_secrets": true,
    "no_side_effects": true,
    "no_capability_invention": true,
    "no_generic_access": true,
    "forbidden_tool_shapes": [
      "sql_query",
      "execute_any_api",
      "drive_search_global",
      "http_request_anywhere",
      "run_code",
      "write_file_anywhere"
    ],
    "rules": [
      "Um agente só pode invocar tool explicitamente listada em seu allowed_tools.",
      "Agente desconhecido é tratado como não autorizado (ACCESS_DENIED), nunca como permitido.",
      "Tool não declarada neste contrato não existe (UNKNOWN_TOOL), mesmo que o agente peça por ela.",
      "Nenhum input pode ampliar escopo: raízes e allowlists são fixas no contrato.",
      "Toda resposta usa o envelope padrão; erros nunca são silenciosos."
    ]
  },
  "agents": [
    {
      "id": "rufas-router",
      "role": "Roteador de intenção entre subagentes. Não executa capability de negócio.",
      "allowed_tools": [],
      "rationale": "Router não acessa dado. Qualquer tool invocada por ele retorna ACCESS_DENIED."
    },
    {
      "id": "marketing-nar",
      "role": "Conteúdo, campanhas e assets de marca.",
      "allowed_tools": [
        "eduinfo_list_root",
        "eduinfo_search_folder",
        "eduinfo_get_asset",
        "campaign_get_history",
        "campaign_get_brand_context"
      ]
    },
    {
      "id": "atendimento-nar",
      "role": "Atendimento e cadência com contatos.",
      "allowed_tools": [
        "crm_list_eligible_contacts",
        "crm_get_contact_context",
        "crm_get_followups_due",
        "crm_get_demo_scheduled",
        "proposal_get_pending"
      ]
    },
    {
      "id": "crm-nar",
      "role": "Higiene, priorização e leitura do funil.",
      "allowed_tools": [
        "crm_list_eligible_contacts",
        "crm_get_contact_context",
        "crm_get_followups_due",
        "crm_get_demo_scheduled",
        "proposal_get_pending"
      ]
    },
    {
      "id": "produto-nar",
      "role": "Produto, documentação e posicionamento.",
      "allowed_tools": [
        "eduinfo_list_root",
        "eduinfo_search_folder",
        "eduinfo_get_asset",
        "proposal_get_pending",
        "campaign_get_history",
        "campaign_get_brand_context"
      ]
    },
    {
      "id": "engenharia-nar",
      "role": "Engenharia e integrações.",
      "allowed_tools": [
        "eduinfo_list_root",
        "eduinfo_search_folder",
        "eduinfo_get_asset"
      ]
    }
  ],
  "scope": {
    "eduinfo": {
      "authorized_roots": [
        "fld_eduinfo_root"
      ],
      "authorized_folders": [
        "fld_eduinfo_root",
        "fld_marketing_assets",
        "fld_produto_docs",
        "fld_institucional"
      ],
      "note": "Qualquer folder ou file fora desta allowlist retorna ASSET_OUT_OF_SCOPE. O input não pode alterar a raiz."
    },
    "limits": {
      "default_limit": 20,
      "max_limit": 100
    }
  },
  "response_envelope": {
    "success": {
      "ok": true,
      "tool": "<tool_name>",
      "agent": "<agent_id>",
      "data": "<output conforme outputSchema da tool>"
    },
    "error": {
      "ok": false,
      "tool": "<tool_name>",
      "agent": "<agent_id>",
      "error": {
        "code": "<error_code>",
        "message": "<mensagem legível, sem vazar dado sensível>"
      }
    }
  },
  "evaluation_order": [
    {
      "step": 1,
      "check": "A tool existe neste contrato?",
      "on_fail": "UNKNOWN_TOOL"
    },
    {
      "step": 2,
      "check": "O agente existe e tem a tool em allowed_tools?",
      "on_fail": "ACCESS_DENIED"
    },
    {
      "step": 3,
      "check": "O input valida contra o inputSchema?",
      "on_fail": "INVALID_INPUT"
    },
    {
      "step": 4,
      "check": "O limit respeita max_limit?",
      "on_fail": "LIMIT_EXCEEDED"
    },
    {
      "step": 5,
      "check": "O recurso está dentro do escopo autorizado?",
      "on_fail": "ASSET_OUT_OF_SCOPE"
    },
    {
      "step": 6,
      "check": "O recurso existe no dataset?",
      "on_fail": "<*>_NOT_FOUND | BRAND_UNKNOWN"
    },
    {
      "step": 7,
      "check": "Resolver dados do mock",
      "on_fail": null
    }
  ],
  "error_codes": {
    "UNKNOWN_TOOL": "Tool não declarada no contrato.",
    "ACCESS_DENIED": "Agente não autorizado para esta tool (inclui agente desconhecido).",
    "INVALID_INPUT": "Input não valida contra o inputSchema da tool.",
    "LIMIT_EXCEEDED": "Parâmetro limit acima de scope.limits.max_limit.",
    "ASSET_OUT_OF_SCOPE": "Recurso existe, mas está fora da allowlist autorizada.",
    "FOLDER_NOT_FOUND": "Folder_ID inexistente dentro do escopo autorizado.",
    "FILE_NOT_FOUND": "File_ID inexistente dentro do escopo autorizado.",
    "CONTACT_NOT_FOUND": "contact_id inexistente no dataset CRM.",
    "PROPOSAL_NOT_FOUND": "proposal_id inexistente no dataset de propostas.",
    "BRAND_UNKNOWN": "Marca não registrada em brand_context."
  },
  "empty_result_convention": {
    "is_error": false,
    "shape": {
      "ok": true,
      "data": {
        "<collection>": [],
        "count": 0
      }
    },
    "note": "Resultado vazio é sucesso, nunca erro."
  },
  "tools": [
