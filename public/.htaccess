# SPA fallback (Hostinger / Apache / LiteSpeed).
# Sem isto, acesso direto ou refresh em /configuracoes, /leads e /leads/:id
# devolve 404 do servidor — inclusive no retorno do OAuth do Google.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos e diretórios reais são servidos como estão.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota entra no index.html (React Router assume daqui).
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html nunca em cache: garante que o deploy novo apareça na hora.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Assets com hash no nome podem ser cacheados agressivamente.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
