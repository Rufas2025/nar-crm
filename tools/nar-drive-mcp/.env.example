# nar_drive MCP — exemplo de configuração. NÃO coloque segredos aqui.
# Copie para um arquivo privado (chmod 600) fora do repositório, por exemplo:
#   /home/hermes/.hermes/secrets/nar_drive.env

# OBRIGATÓRIO: caminho do JSON da service account (escopo drive.readonly).
# O arquivo de credenciais vive fora do repositório e nunca é versionado.
NAR_DRIVE_CREDENTIALS_FILE=/home/hermes/.hermes/secrets/nar_drive_sa.json

# Pasta raiz autorizada (Eduinfo_2026_nar). Só descendentes dela são acessíveis.
NAR_DRIVE_ROOT_FOLDER_ID=1WcIuTx8ydx-8umN3PiFQ9OPJGtnG6EpL

# Opcional: e-mail a ser impersonado via domain-wide delegation (Workspace).
# NAR_DRIVE_IMPERSONATE_SUBJECT=usuario@seudominio.com

# Opcional: diretório privado (0700) para os assets temporários baixados.
# Padrão: $HERMES_HOME/cache/nar_drive
NAR_DRIVE_CACHE_DIR=/home/hermes/.hermes/cache/nar_drive

# Opcional: limites operacionais.
NAR_DRIVE_DEFAULT_PAGE_SIZE=50
NAR_DRIVE_MAX_PAGE_SIZE=200
NAR_DRIVE_MAX_ANCESTRY_DEPTH=32
NAR_DRIVE_MAX_SEARCH_SCAN=500
NAR_DRIVE_MAX_DOWNLOAD_BYTES=536870912
NAR_DRIVE_INLINE_IMAGE_MAX_BYTES=4194304
NAR_DRIVE_ASSET_TTL_SECONDS=3600
